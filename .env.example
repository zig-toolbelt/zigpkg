DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"
GITHUB_TOKEN=""
# Optional: enables Codeberg (Forgejo) as a second package source. When the sync
# job sees a non-empty CODEBERG_TOKEN it also crawls codeberg.org; the panel
# uses it for authenticated README/tag/file reads (anonymous reads if unset).
CODEBERG_TOKEN=""
SYNC_API_KEY=""
PUBLIC_SITE_URL="https://zigpkg.dev"

# Auth.js (GitHub sign-in only, no email/password). AUTH_SECRET: `npx auth secret`.
# AUTH_GITHUB_ID/SECRET: from a GitHub OAuth App (callback URL
# {PUBLIC_SITE_URL}/auth/callback/github, or http://localhost:5173/auth/callback/github
# for local dev). AUTH_TRUST_HOST is required in prod, behind the ingress proxy.
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_TRUST_HOST="true"

# Manual submission moderation: members of this GitHub team (in this org) can
# approve/reject user-submitted packages. The signed-in user's own OAuth token
# (read:org scope) is used for the membership check.
MODERATOR_ORG="zigpkg"
MODERATOR_TEAM="moderators"

# Admin access: comma-separated GitHub usernames with full /admin access
# (dashboard, user management including ban/unban, package management
# including delete/status/owner changes, read-only moderator list). Unlike
# moderators, admins are not resolved through a GitHub team — this list is the
# source of truth. Keep it small.
ADMIN_USERNAMES=""
